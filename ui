# ============================================================
# 1. MAIN AI ANALYSIS FUNCTION
# ============================================================

def analyze_palm(
    image,
    palm_id,
    palm_variety,
    temperature,
    humidity,
    soil_moisture,
    soil_ec
):

    # --------------------------------------------------------
    # Validation
    # --------------------------------------------------------

    errors = []

    if image is None:
        errors.append("❌ Please upload a palm/date bunch image.")

    if palm_id is None or str(palm_id).strip() == "":
        errors.append("❌ Please enter the Palm ID.")

    if palm_variety is None or str(palm_variety).strip() == "":
        errors.append("❌ Please enter the palm variety.")

    if temperature is None:
        errors.append("❌ Please enter temperature.")

    if humidity is None:
        errors.append("❌ Please enter humidity.")

    if soil_moisture is None:
        errors.append("❌ Please enter soil moisture.")

    if soil_ec is None:
        errors.append("❌ Please enter soil EC.")

    # --------------------------------------------------------
    # Return errors
    # --------------------------------------------------------

    if errors:

        error_text = "\n\n".join(errors)

        return (
            error_text,
            "",
            "",
            "",
            0,
            "",
            "",
            ""
        )


    # --------------------------------------------------------
    # Simulated Vision Agent
    # --------------------------------------------------------

    # Prototype logic
    # Later this section can be replaced by the real
    # computer vision model.

    if soil_moisture < 15:

        fruit_density = "Medium"
        fruit_load = "Medium"

    else:

        fruit_density = "High"
        fruit_load = "High"


    vision_confidence = 0.91


    # --------------------------------------------------------
    # Agriculture Agent
    # --------------------------------------------------------

    if fruit_density == "High":

        competition = "High"

        agriculture_assessment = (
            "Fruit density is high compared with the "
            "expected level for this palm variety. "
            "Competition between fruits may occur."
        )

    else:

        competition = "Moderate"

        agriculture_assessment = (
            "Fruit density is within an acceptable range. "
            "Competition between fruits appears limited."
        )


    # --------------------------------------------------------
    # Decision Agent
    # --------------------------------------------------------

    if fruit_load == "High" and competition == "High":

        recommendation = "Thinning should be considered"

        thinning_percentage = 25

        priority = "Medium"

        farmer_reason = (
            f"Fruit density is high compared with the "
            f"usual level for {palm_variety}."
        )

    else:

        recommendation = "No thinning required"

        thinning_percentage = 0

        priority = "Low"

        farmer_reason = (
            f"Fruit density appears suitable for {palm_variety}."
        )


    # --------------------------------------------------------
    # Confidence
    # --------------------------------------------------------

    confidence = vision_confidence

    # Simple sensor consistency adjustment

    if temperature > 50:

        confidence -= 0.03

    if humidity < 10:

        confidence -= 0.02

    confidence = max(0, min(confidence, 1))

    confidence_percent = int(confidence * 100)


    # --------------------------------------------------------
    # Structured Agent Outputs
    # --------------------------------------------------------

    vision_result = {

        "agent": "Vision Agent",

        "fruit_density": fruit_density,

        "fruit_load": fruit_load,

        "confidence": confidence_percent
    }


    agriculture_result = {

        "agent": "Agriculture Agent",

        "palm_variety": palm_variety,

        "competition_between_fruits": competition,

        "assessment": agriculture_assessment
    }


    decision_result = {

        "agent": "Decision Agent",

        "recommendation": recommendation,

        "recommended_thinning_percentage":
            thinning_percentage,

        "priority": priority
    }


    # --------------------------------------------------------
    # Final JSON
    # --------------------------------------------------------

    final_result = {

        "system": "Ghosn Al-Qana AI",

        "timestamp":
            datetime.now().strftime("%Y-%m-%d %H:%M:%S"),

        "palm": {

            "palm_id": palm_id,

            "variety": palm_variety
        },

        "sensor_data": {

            "temperature_c": temperature,

            "humidity_percent": humidity,

            "soil_moisture_percent": soil_moisture,

            "soil_ec": soil_ec
        },

        "vision_agent": vision_result,

        "agriculture_agent": agriculture_result,

        "decision_agent": decision_result,

        "confidence_score":
            confidence_percent,

        "farmer_reason":
            farmer_reason
    }


    json_result = json.dumps(
        final_result,
        ensure_ascii=False,
        indent=2
    )


    # --------------------------------------------------------
    # UI Agent Results
    # --------------------------------------------------------

    vision_text = f"""
### 👁️ Vision Agent

**Fruit Density:** {fruit_density}

**Fruit Load:** {fruit_load}

**Vision Confidence:** {confidence_percent}%
"""


    agriculture_text = f"""
### 🌱 Agriculture Agent

**Competition:** {competition}

**Assessment:**

{agriculture_assessment}
"""


    decision_text = f"""
### 🤖 Decision Agent

**Recommendation:**

{recommendation}

**Recommended Thinning:** {thinning_percentage}%

**Priority:** {priority}
"""


    confidence_text = (
        f"### 🎯 Confidence Score\n\n"
        f"**{confidence_percent}%**"
    )


    return (

        "",

        vision_text,

        agriculture_text,

        decision_text,

        confidence,

        confidence_text,

        farmer_reason,

        json_result
    )


# ============================================================
# 2. APPROVE FUNCTION
# ============================================================

def approve_recommendation(
    palm_id,
    recommendation,
    percentage
):

    if palm_id == "" or recommendation == "":

        return (
            "❌ Please analyze the palm first."
        )


    return f"""
## ✅ Recommendation Approved

**Palm ID:** {palm_id}

**Recommendation:** {recommendation}

**Thinning Percentage:** {percentage}

**Status:** Approved

The recommendation has been recorded successfully.
"""


# ============================================================
# 3. REJECT FUNCTION
# ============================================================

def reject_recommendation(
    palm_id,
    recommendation
):

    if palm_id == "" or recommendation == "":

        return (
            "❌ Please analyze the palm first."
        )


    return f"""
## ❌ Recommendation Rejected

**Palm ID:** {palm_id}

**Recommendation:** {recommendation}

**Status:** Rejected

The farmer rejected the AI recommendation.
"""


